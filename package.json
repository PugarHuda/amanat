{
  "name": "amanat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "miner/server.mjs",
  "bin": {
    "storm": "app/storm.mjs"
  },
  "description": "Verified weather intelligence that a contract acts on: a Telegraph miner, a scoring module, and an on-chain agent.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "miner": "node miner/server.mjs",
    "test": "node miner/test.mjs && node agent/test.mjs && node app/test.mjs && node scripts/check-sources.mjs && cd scorer && cargo test --features game2",
    "lint": "eslint . && solhint \"onchain/src/**/*.sol\"",
    "typecheck": "tsc -p jsconfig.json",
    "audit": "node agent/audit-jobable.mjs",
    "build:scorer": "cd scorer && cargo build --release --target wasm32-unknown-unknown",
    "bench": "node scorer/harness.mjs scorer/dist/*.wasm scorer/champions/*.wasm",
    "attacks": "node scorer/harness.mjs --attacks scorer/target/wasm32-unknown-unknown/release/amanat_scorer.wasm",
    "agent:dry": "node --env-file=.env agent/run.mjs --dry",
    "agent": "node --env-file=.env agent/run.mjs",
    "route": "node --env-file=.env agent/route.mjs",
    "build:profiles": "node scorer/build-profiles.mjs",
    "wallet": "node --env-file=.env agent/wallet-status.mjs",
    "miner:check": "node agent/miner-check.mjs",
    "register:miner": "node --env-file=.env agent/register-miner.mjs",
    "register:wasm": "node --env-file=.env agent/register-wasm.mjs",
    "subscribe": "node --env-file=.env agent/subscribe.mjs",
    "deploy": "node --env-file=.env agent/deploy.mjs",
    "policy": "node --env-file=.env agent/policy.mjs",
    "test:e2e": "playwright test",
    "build:contract": "node onchain/build.mjs",
    "board": "node --env-file=.env agent/board.mjs",
    "crosscheck": "node --env-file=.env agent/crosscheck.mjs",
    "survey": "node agent/survey.mjs",
    "impact": "node agent/impact.mjs",
    "expire": "node --env-file=.env agent/expire.mjs"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "htmlparser2": "^12.0.0",
    "solhint": "^6.2.4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}

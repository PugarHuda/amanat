{
  "name": "amanat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified weather intelligence that a contract acts on: a Telegraph miner, a scoring module, and an on-chain agent.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "miner": "node miner/server.mjs",
    "test": "node miner/test.mjs && cd scorer && cargo test",
    "audit": "node agent/audit-jobable.mjs",
    "build:scorer": "cd scorer && cargo build --release --target wasm32-unknown-unknown",
    "bench": "node scorer/harness.mjs scorer/dist/*.wasm scorer/champions/*.wasm",
    "attacks": "node scorer/harness.mjs --attacks scorer/target/wasm32-unknown-unknown/release/amanat_scorer.wasm",
    "agent:dry": "node agent/run.mjs --dry",
    "agent": "node agent/run.mjs",
    "build:profiles": "node scorer/build-profiles.mjs",
    "wallet": "node --env-file=.env agent/wallet-status.mjs",
    "miner:check": "node agent/miner-check.mjs",
    "register:miner": "node --env-file=.env agent/register-miner.mjs",
    "register:wasm": "node --env-file=.env agent/register-wasm.mjs",
    "subscribe": "node --env-file=.env agent/subscribe.mjs",
    "deploy": "node --env-file=.env agent/deploy.mjs",
    "policy": "node --env-file=.env agent/policy.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.config.mjs"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}

# Base Sepolia wallet the agent acts as. Needs a little ETH for gas and USDC for
# jobs. Never commit the real file.
AGENT_PRIVATE_KEY=

# Deployed onchain/Amanat.sol. Set after the first deploy.
AMANAT_CONTRACT=

# Where the Amanat miner is reachable for free screening.
AMANAT_MINER=http://127.0.0.1:8787

# Defaults below are the live testnet values; override only to point elsewhere.
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
TELEGRAPH_DIAMOND=0x5a2324aA18613FAD4e44bDF0d6c73Ec1f6D87ff8
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Payout address registered with the miner (MACHINA settles here).
FEE_ADDRESS=0x3AaA5b87bD13BE841E824E62cc4C66004420B7c3

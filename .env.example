# Base Sepolia wallet the agent acts as. Needs a little ETH for gas and USDC for
# x402 calls and jobs. Never commit the real file.
AGENT_PRIVATE_KEY=

# Deployed onchain/Amanat.sol. Set after `npm run deploy`.
AMANAT_CONTRACT=

# ── Defaults below are the live testnet values; override only to point elsewhere.
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
TELEGRAPH_WS=wss://devnode.telegraphprotocol.com/engine/ws
TELEGRAPH_DIAMOND=0x5a2324aA18613FAD4e44bDF0d6c73Ec1f6D87ff8
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# The public sepolia.base.org endpoint serves its own writes back stale often
# enough to break a script — a confirmed approve simulating as "exceeds
# allowance", a confirmed transfer reading as a zero balance. Use another.
BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com

# Payout address registered with the miner. MACHINA settles here.
FEE_ADDRESS=

# ── Agent behaviour
# Screen below this and a policy is not worth a $1 job.
AMANAT_ESCALATE_AT=0.45
# The intent jobs settle against. Must be one the protocol resolves by name, or
# the job pins itself to a single miner — see README.
AMANAT_INTENT=STORM_ALERT

# ── Deploy sizing (npm run deploy)
AMANAT_BOOK_USDC=8
AMANAT_ESCROW_USDC=3

# ── Registration (agent/register-miner.mjs, agent/register-wasm.mjs)
# Immutable raw URLs — a commit SHA, not a branch. The node re-fetches and
# re-hashes what you committed to, and a branch URL can change underneath it.
AMANAT_YAML_URL=
AMANAT_WASM_URL=

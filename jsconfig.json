{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["agent/**/*.mjs", "miner/**/*.mjs", "scorer/*.mjs", "scripts/*.mjs", "test/*.mjs", "onchain/*.mjs"],
  "exclude": ["node_modules"]
}
